<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/hyper_bg">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center"
        android:alpha="0" android:id="@+id/splashContent">
        <ImageView android:layout_width="96dp" android:layout_height="96dp"
            android:src="@drawable/ic_launcher_foreground" android:scaleType="fitCenter"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="HYPER" android:textSize="40sp" android:textStyle="bold"
            android:textColor="@color/hyper_text_primary" android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08" android:layout_marginTop="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Messenger" android:textSize="16sp"
            android:textColor="@color/hyper_accent" android:layout_marginTop="4dp"/>
    </LinearLayout>
</FrameLayout>
