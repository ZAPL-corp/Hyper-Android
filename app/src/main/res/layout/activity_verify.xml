<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/hyper_bg" android:orientation="vertical"
    android:gravity="center" android:paddingHorizontal="32dp">
    <TextView android:text="📧" android:textSize="56sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>
    <TextView android:text="Подтвердите почту"
        android:textSize="24sp" android:textStyle="bold"
        android:textColor="@color/hyper_text_primary"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"/>
    <TextView android:id="@+id/tvVerifyHint"
        android:text="Введите 6-значный код, отправленный на ваш email"
        android:textSize="14sp" android:textColor="@color/hyper_text_muted"
        android:gravity="center" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginBottom="32dp"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCode" style="@style/Widget.HYPER.EditText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Код подтверждения" android:layout_marginBottom="24dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number"
            android:maxLength="6" android:textColor="@color/hyper_text_primary"
            android:gravity="center" android:textSize="24sp" android:letterSpacing="0.3"/>
    </com.google.android.material.textfield.TextInputLayout>
    <Button android:id="@+id/btnVerify" android:layout_width="match_parent"
        android:layout_height="56dp" android:text="Подтвердить"
        android:background="@drawable/bg_button_accent"
        android:textColor="@color/hyper_bg" android:textStyle="bold" android:textSize="15sp"/>
    <ProgressBar android:id="@+id/progressBar" android:layout_width="48dp"
        android:layout_height="48dp" android:layout_marginTop="20dp"
        android:visibility="gone" android:indeterminateTint="@color/hyper_accent"/>
    <TextView android:id="@+id/tvError" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/hyper_red"
        android:textSize="13sp" android:gravity="center" android:layout_marginTop="12dp"
        android:visibility="gone"/>
</LinearLayout>
