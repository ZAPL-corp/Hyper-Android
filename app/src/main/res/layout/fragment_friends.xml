<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/hyper_bg" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="10dp"
        android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Друзья"
            android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/hyper_text_primary" android:fontFamily="sans-serif-black"/>
        <ImageView android:id="@+id/btnAddFriend" android:layout_width="40dp"
            android:layout_height="40dp" android:src="@drawable/ic_add"
            android:padding="8dp" android:background="@drawable/bg_card"
            android:contentDescription="Добавить друга"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:background="@drawable/bg_search" android:gravity="center_vertical"
        android:paddingHorizontal="14dp" android:marginHorizontal="16dp"
        android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_search"/>
        <EditText android:id="@+id/etSearchFriends" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:background="@null" android:hint="Найти пользователя…"
            android:hintTextColor="@color/hyper_text_muted" android:textColor="@color/hyper_text_primary"
            android:textSize="14sp" android:paddingStart="10dp"
            android:inputType="text" android:imeOptions="actionSearch"/>
    </LinearLayout>

    <!-- Входящие заявки -->
    <TextView android:id="@+id/tvIncomingLabel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Входящие заявки" android:textColor="@color/hyper_text_muted"
        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:paddingHorizontal="20dp" android:paddingBottom="6dp"
        android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIncoming" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Мои друзья" android:textColor="@color/hyper_text_muted"
        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:paddingHorizontal="20dp" android:paddingBottom="6dp"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFriends" android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
