<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/hyper_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="32dp">

        <!-- Header gradient -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingTop="40dp" android:paddingBottom="28dp"
            android:background="@color/hyper_surface">
            <FrameLayout android:layout_width="88dp" android:layout_height="88dp"
                android:layout_marginBottom="14dp">
                <TextView android:id="@+id/tvProfileAvatarLetter"
                    android:layout_width="88dp" android:layout_height="88dp"
                    android:background="@drawable/bg_avatar" android:gravity="center"
                    android:textColor="@color/hyper_bg" android:textSize="32sp"
                    android:textStyle="bold"/>
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="88dp" android:layout_height="88dp"
                    android:visibility="gone"/>
            </FrameLayout>
            <TextView android:id="@+id/tvProfileUsername"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Загрузка…" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/hyper_text_primary"/>
            <TextView android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/hyper_text_muted"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="20dp">

            <!-- QR Вход -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="АВТОРИЗАЦИЯ" android:textColor="@color/hyper_text_muted"
                android:textSize="11sp" android:letterSpacing="0.1" android:textStyle="bold"
                android:paddingHorizontal="4dp" android:layout_marginBottom="8dp"/>
            <LinearLayout android:id="@+id/cardQrLogin" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_card"
                android:gravity="center_vertical" android:paddingHorizontal="16dp"
                android:paddingVertical="16dp" android:layout_marginBottom="6dp">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_qr" android:layout_marginEnd="14dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Войти по QR-коду"
                        android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/hyper_text_primary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Отсканируй QR с ПК-версии"
                        android:textSize="12sp" android:textColor="@color/hyper_text_muted"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:text="›" android:textSize="22sp"
                    android:textColor="@color/hyper_text_muted"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Настройки -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="НАСТРОЙКИ" android:textColor="@color/hyper_text_muted"
                android:textSize="11sp" android:letterSpacing="0.1" android:textStyle="bold"
                android:paddingHorizontal="4dp" android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/cardTheme" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_card"
                android:gravity="center_vertical" android:paddingHorizontal="16dp"
                android:paddingVertical="14dp" android:layout_marginBottom="6dp">
                <TextView android:text="🎨" android:textSize="22sp" android:layout_marginEnd="14dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Тема приложения"
                    android:textSize="15sp" android:textColor="@color/hyper_text_primary"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDarkMode"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:thumbTint="@color/hyper_accent"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardNotifications" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_card"
                android:gravity="center_vertical" android:paddingHorizontal="16dp"
                android:paddingVertical="14dp" android:layout_marginBottom="6dp">
                <TextView android:text="🔔" android:textSize="22sp" android:layout_marginEnd="14dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Уведомления"
                    android:textSize="15sp" android:textColor="@color/hyper_text_primary"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true" android:thumbTint="@color/hyper_accent"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardTwoFa" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_card"
                android:gravity="center_vertical" android:paddingHorizontal="16dp"
                android:paddingVertical="16dp" android:layout_marginBottom="6dp">
                <TextView android:text="🔒" android:textSize="22sp" android:layout_marginEnd="14dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="Двойная защита (2FA)"
                        android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/hyper_text_primary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Защитите аккаунт от взлома"
                        android:textSize="12sp" android:textColor="@color/hyper_text_muted"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:text="›" android:textSize="22sp"
                    android:textColor="@color/hyper_text_muted"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Выйти -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="АККАУНТ" android:textColor="@color/hyper_text_muted"
                android:textSize="11sp" android:letterSpacing="0.1" android:textStyle="bold"
                android:paddingHorizontal="4dp" android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout android:id="@+id/cardLogout" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/bg_card"
                android:gravity="center_vertical" android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">
                <TextView android:text="🚪" android:textSize="22sp" android:layout_marginEnd="14dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Выйти из аккаунта"
                    android:textSize="15sp" android:textColor="@color/hyper_red"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
