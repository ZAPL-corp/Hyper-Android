<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="start"
    android:paddingVertical="3dp">
    <FrameLayout android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginEnd="8dp" android:layout_marginTop="4dp">
        <TextView android:id="@+id/tvAvatarLetter"
            android:layout_width="34dp" android:layout_height="34dp"
            android:background="@drawable/bg_avatar" android:gravity="center"
            android:textColor="@color/hyper_bg" android:textSize="12sp" android:textStyle="bold"/>
    </FrameLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/tvSender"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/hyper_accent" android:textSize="12sp"
            android:textStyle="bold" android:paddingBottom="3dp"/>
        <TextView android:id="@+id/tvMessage"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_message_in"
            android:textColor="@color/hyper_text_primary" android:textSize="15sp"
            android:paddingHorizontal="14dp" android:paddingVertical="10dp"
            android:maxWidth="280dp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:id="@+id/reactionsContainer" android:paddingTop="4dp"/>
        <TextView android:id="@+id/tvTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/hyper_text_muted" android:textSize="10sp"
            android:paddingTop="2dp" android:paddingStart="4dp"/>
    </LinearLayout>
</LinearLayout>
