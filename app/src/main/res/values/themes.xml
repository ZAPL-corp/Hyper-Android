<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HYPER" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/hyper_accent</item>
        <item name="colorPrimaryVariant">@color/hyper_accent_dark</item>
        <item name="colorOnPrimary">@color/hyper_bg</item>
        <item name="colorSecondary">@color/hyper_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/hyper_surface</item>
        <item name="colorOnSurface">@color/hyper_text_primary</item>
        <item name="colorSurfaceVariant">@color/hyper_elevated</item>
        <item name="colorBackground">@color/hyper_bg</item>
        <item name="android:colorBackground">@color/hyper_bg</item>
        <item name="android:statusBarColor">@color/hyper_bg</item>
        <item name="android:navigationBarColor">@color/hyper_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.HYPER.Splash" parent="Theme.HYPER">
        <item name="android:windowBackground">@color/hyper_bg</item>
    </style>

    <style name="Widget.HYPER.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/hyper_accent</item>
        <item name="android:textColor">@color/hyper_bg</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">30dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.HYPER.ButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/hyper_border</item>
        <item name="android:textColor">@color/hyper_text_secondary</item>
        <item name="cornerRadius">30dp</item>
    </style>

    <style name="Widget.HYPER.EditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/hyper_border</item>
        <item name="hintTextColor">@color/hyper_text_muted</item>
        <item name="boxBackgroundColor">@color/hyper_elevated</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.HYPER.Rounded</item>
    </style>

    <style name="ShapeAppearance.HYPER.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

</resources>
